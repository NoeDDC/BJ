# Copy this to .env and fill in what you need. .env is only for local
# development — python-dotenv loads it automatically when you run
# `python server.py`. It's gitignored and never used in production: Render
# has its own environment variables, set directly in its dashboard.

# --- Database ---
# Leave DATABASE_URL empty/unset to use local SQLite automatically
# (recommended for local dev). Only set it if you deliberately want your
# local server to read/write the real Neon database.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Where to store the local SQLite file when DATABASE_URL is not set. The
# code's built-in default (/data/counters.db) assumes a Linux server disk,
# so override it locally to write next to the project instead.
DB=./data/counters.db

# --- Server ---
PORT=3000

# --- Push notifications (optional) ---
# Only changes the "sub" contact claim sent with VAPID. Has a sensible
# default already in backend/push.py.
# VAPID_SUBJECT=mailto:you@example.com

# --- Only needed if you run scripts/neon_get_connection_string.py ---
# Get this from Neon Console -> your project -> Developer settings -> API keys.
# Prefer exporting it inline instead of storing it here, so it isn't sitting
# on disk longer than needed:
#   NEON_API_KEY=napi_xxx python scripts/neon_get_connection_string.py
# NEON_API_KEY=napi_xxx
